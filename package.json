{
  "name": "ottrix-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json --noEmit",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev": "npm run dev --workspace=packages/core",
    "audit": "npm audit --audit-level=moderate",
    "lint:fix": "eslint packages --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepublish:check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:exports && npm run verify:pack",
    "publish:all": "node scripts/publish-all.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*",
    "examples/http-agents/*"
  ],
  "overrides": {
    "esbuild": "0.28.1",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.19",
    "postcss": "8.5.28",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "find-my-way": "9.9.0",
    "multer": "2.4.0",
    "qs": "6.16.0",
    "ip-address": "10.7.2",
    "linkify-it": "5.0.2",
    "baseline-browser-mapping": "2.11.26",
    "hono": "4.13.10",
    "body-parser": "2.3.0",
    "fastify": {
      "find-my-way": "9.9.0"
    },
    "next": {
      "baseline-browser-mapping": "2.11.26",
      "postcss": "8.5.28"
    },
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "1.19.17",
      "hono": "4.13.10"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.1",
    "esbuild": "0.28.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.8.3",
    "turbo": "^2.9.14",
    "typedoc": "^0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@mastra/core": "^1.71.0",
    "zod": "4.4.3"
  }
}
