{
  "name": "ottrix-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json --noEmit",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev": "npm run dev --workspace=packages/core",
    "audit": "npm audit --audit-level=moderate",
    "lint:fix": "eslint packages --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepublish:check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:exports && npm run verify:pack"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.0",
    "eslint": "10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.8.3",
    "turbo": "^2.9.14",
    "typedoc": "^0.28.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4"
  },
  "dependencies": {
    "@langchain/core": "^0.3.66",
    "@mastra/core": "^1.36.0",
    "zod": "^3.25.76"
  }
}
