{
  "name": "@ottrix/mastra",
  "private": false,
  "version": "0.1.0",
  "description": "Bridge ottrix providers, tools, and agents into Mastra",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.0.0",
    "@ottrix/vercel-ai": "*",
    "ottrix": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@ottrix/vercel-ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.10",
    "@mastra/core": "^1.36.0",
    "@ottrix/vercel-ai": "*",
    "@types/node": "25.9.0",
    "ottrix": "*",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "zod": "3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashwinpaulallen/ottrix.git",
    "directory": "packages/mastra"
  },
  "publishConfig": {
    "access": "public"
  }
}
