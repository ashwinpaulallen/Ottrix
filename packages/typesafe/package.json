{
  "name": "@ottrix/typesafe",
  "version": "0.1.0",
  "description": "TypeSafe AI / Jev integration for ottrix — fast typed decisions for evaluation, routing, and guardrails",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "ottrix": ">=2.0.0",
    "@typesafe-ai/sdk": ">=0.6.0"
  },
  "devDependencies": {
    "ottrix": "*",
    "@typesafe-ai/sdk": "^0.6.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashwinpaulallen/Ottrix.git",
    "directory": "packages/typesafe"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ottrix",
    "typesafe",
    "jev",
    "ai",
    "decisions",
    "evaluation"
  ]
}
