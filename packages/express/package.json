{
  "name": "@ottrix/express",
  "private": true,
  "version": "0.1.0",
  "description": "Express middleware and router for ottrix agents",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "ottrix": ">=2.0.0",
    "express": ">=4.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "25.9.0",
    "@types/supertest": "^6.0.3",
    "express": "^4.21.2",
    "ottrix": "*",
    "supertest": "^7.1.4",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "zod": "^3.24.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashwinpaulallen/ottrix.git",
    "directory": "packages/express"
  },
  "publishConfig": {
    "access": "public"
  }
}
