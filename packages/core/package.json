{
  "name": "ottrix",
  "private": false,
  "version": "2.2.0",
  "description": "TypeScript LLM agent framework: ReAct loop, tool calling, MCP, multi-agent workflows, memory, guardrails. Anthropic Claude, OpenAI, Ollama via fetch — vendor-neutral, zero SDK deps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js",
      "require": "./dist/providers/*.cjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "require": "./dist/tools/index.cjs"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "require": "./dist/memory/index.cjs"
    },
    "./orchestration": {
      "types": "./dist/orchestration/index.d.ts",
      "import": "./dist/orchestration/index.js",
      "require": "./dist/orchestration/index.cjs"
    },
    "./guardrails": {
      "types": "./dist/guardrails/index.d.ts",
      "import": "./dist/guardrails/index.js",
      "require": "./dist/guardrails/index.cjs"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js",
      "require": "./dist/observability/index.cjs"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js",
      "require": "./dist/agent/index.cjs"
    },
    "./evals": {
      "types": "./dist/evals/index.d.ts",
      "import": "./dist/evals/index.js",
      "require": "./dist/evals/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./testing/contract": {
      "types": "./dist/testing/contract.d.ts",
      "import": "./dist/testing/contract.js"
    },
    "./exporters/*": {
      "types": "./dist/observability/exporters/*.d.ts",
      "import": "./dist/observability/exporters/*.js",
      "require": "./dist/observability/exporters/*.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src/ tests/"
  },
  "keywords": [
    "ai",
    "agent",
    "ottrix",
    "llm",
    "framework",
    "multi-agent",
    "mcp",
    "eval",
    "dag",
    "supervisor",
    "structured-output",
    "vendor-agnostic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashwinpaulallen/ottrix.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ashwinpaulallen/ottrix#readme",
  "bugs": {
    "url": "https://github.com/ashwinpaulallen/ottrix/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "ioredis": "^5.4.0",
    "js-yaml": "^4.2.0",
    "pg": "^8.11.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "js-yaml": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "zod": "4.4.3"
  }
}
